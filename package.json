{
  "name": "orca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "TZ=UTC node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "score:extraction": "node --experimental-strip-types scripts/score-extraction.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "test:db": "supabase test db",
    "check:isolation": "node --experimental-strip-types --no-warnings scripts/check-isolation.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
