# Copy to .env.local and fill in. `npm run db:start` prints the local values.

# Supabase (Phase 4). Local: the API URL and keys `supabase start` prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses row-level security. Used by jobs and test fixtures, never sent to the browser.
SUPABASE_SECRET_KEY=

# Claude, Orca's own key (the only model key the server uses). Without it, uploads are stored and
# read but nothing is generated, and prose answers are self-marked.
ANTHROPIC_API_KEY=
# Tests point this at a fake Messages API; leave unset otherwise.
# ANTHROPIC_BASE_URL=

# Jobs: `inline` runs uploads and top-ups inside the request (local dev, tests, CI);
# `trigger` sends them to Trigger.dev (production).
ORCA_JOBS=inline
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# The site's address, where emailed links (confirm, reset password) bring the student back, e.g.
# https://orca-ocean.vercel.app. Required in production; development falls back to the request's host.
# Add it (with /auth/callback) to Supabase's redirect URL list (docs/SETUP-HOSTED.md).
SITE_URL=

# The service-wide ceiling on estimated model spend per UTC day, in dollars (decision 10). Past it every
# new model call waits until tomorrow, for everyone. Unset = no ceiling (development only); production sets it.
ORCA_DAILY_BUDGET_USD=
